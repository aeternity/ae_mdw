#!/bin/sh

export RELEASE_MODE=interactive
export RELEASE_NODE=aeternity@localhost

# Erlang distribution (epmd and the node listener) only on loopback, so that a neighbouring
# container can't connect. bin/ae_mdw rpc and remote run inside the container.
export ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-127.0.0.1}"
export ERL_AFLAGS="${ERL_AFLAGS:+$ERL_AFLAGS }-kernel inet_dist_use_interface {127,0,0,1}"
